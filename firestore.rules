rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function owner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    match /users/{userId} {
      allow read, write: if owner(userId);

      match /applications/{id} {
        allow read, write: if owner(userId);
      }
      match /outreach/{id} {
        allow read, write: if owner(userId);
      }
      match /bots/{id} {
        allow read, write: if owner(userId);
      }
      match /skills/{id} {
        allow read, write: if owner(userId);
      }
      match /conversations/{id} {
        allow read, write: if owner(userId);
      }
      match /messages/{id} {
        allow read, write: if owner(userId);
      }
      match /desk/{id} {
        allow read, write: if owner(userId);
      }
      match /usage/{id} {
        allow read, write: if owner(userId);
      }
      match /apps/{id} {
        allow read, write: if owner(userId);
      }
    }

    // Written only by Next.js with firebase-admin. Clients cannot read tokens or the waitlist.
    match /extensionTokens/{id} {
      allow read, write: if false;
    }
    match /extensionJobs/{id} {
      allow read, write: if false;
    }
    match /waitlist/{id} {
      allow read, write: if false;
    }
    match /users/{userId}/private/{doc} {
      allow read, write: if false;
    }
  }
}
