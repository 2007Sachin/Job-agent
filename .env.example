# Firebase Auth + Firestore. Leave the Firebase keys blank to use the in-browser demo.
# Do not enable Storage or Cloud Functions (Spark plan has no billing).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# OpenAI-compatible free provider. Examples:
# Gemini:  LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
#          LLM_MODEL=gemini-2.0-flash
# Groq:    LLM_BASE_URL=https://api.groq.com/openai/v1
#          LLM_MODEL=llama-3.3-70b-versatile
# NVIDIA NIM free tier is about 40 requests/minute. This app stays under that with LLM_GLOBAL_RPM.
# LLM_BASE_URL=https://integrate.api.nvidia.com/v1
# LLM_MODEL=mistralai/mistral-large-4-1t-a52b
# Alternative: nvidia/nemotron-3.5-lightning-30b-a3b
# meta/llama-3.3-70b-instruct is end of life. Do not use it.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_GLOBAL_RPM=35
LLM_QUEUE_TIMEOUT_MS=15000
LLM_CACHE_TTL_HOURS=24
LLM_FALLBACK_BASE_URL=
LLM_FALLBACK_API_KEY=
LLM_FALLBACK_MODEL=
LLM_DAILY_CAP=25
# Signed-in AI actions per UTC day. Demo mode uses the same number in memory.
AI_DAILY_LIMIT_PER_USER=20
CRON_SECRET=
EXTENSION_TOKEN_SECRET=

# Optional job sources. Remotive is called without a key.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
GREENHOUSE_BOARDS=
LEVER_COMPANIES=

# Gmail send (Google Cloud OAuth client). Users still approve each email.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
