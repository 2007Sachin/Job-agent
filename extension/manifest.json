{
  "manifest_version": 3,
  "name": "Job-agent Save",
  "version": "0.1.0",
  "description": "Save the job page you are looking at into Job-agent. It reads that page only when you click.",
  "action": { "default_popup": "popup.html", "default_icon": "icon.png" },
  "permissions": ["storage", "activeTab"],
  "host_permissions": [
    "https://www.linkedin.com/jobs/*",
    "https://*.naukri.com/*",
    "https://www.instahyre.com/*",
    "https://wellfound.com/jobs/*",
    "https://*.indeed.com/*",
    "https://*.greenhouse.io/*",
    "https://jobs.lever.co/*",
    "http://127.0.0.1:3000/*",
    "http://localhost:3000/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.linkedin.com/jobs/*",
        "https://*.naukri.com/*",
        "https://www.instahyre.com/*",
        "https://wellfound.com/jobs/*",
        "https://*.indeed.com/*",
        "https://*.greenhouse.io/*",
        "https://jobs.lever.co/*",
        "http://127.0.0.1:3000/fixture/*",
        "http://localhost:3000/fixture/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": { "16": "icon.png", "48": "icon.png", "128": "icon.png" }
}
